{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theceej.github.io/proto-viz/protoviz-quiz.schema.json",
  "title": "Proto-viz Quiz Package",
  "type": "object",
  "required": ["app", "kind", "version", "quizId", "title", "description", "educator", "course", "createdAt", "feedbackMode", "customProtocols", "packets", "questions"],
  "properties": {
    "app": { "const": "proto-viz" },
    "kind": { "const": "quiz" },
    "version": { "const": 1 },
    "quizId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "educator": { "type": "string" },
    "course": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "feedbackMode": { "enum": ["instant", "on-submit"] },
    "customProtocols": { "type": "array", "maxItems": 500, "items": { "type": "object" } },
    "packets": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/packet" } },
    "questions": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/question" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "bytes": { "type": "object", "required": ["$bytes"], "properties": { "$bytes": { "type": "string", "contentEncoding": "base64" } }, "additionalProperties": false },
    "packet": {
      "type": "object", "required": ["id", "label", "source", "stack", "expectedBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 },
        "source": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["builder", "saved-stack", "scenario"] }, "id": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false },
        "stack": { "type": "object", "required": ["layers", "trailingPayload"], "properties": { "layers": { "type": "array", "maxItems": 64 }, "trailingPayload": { "$ref": "#/$defs/bytes" } }, "additionalProperties": false },
        "expectedBytes": { "$ref": "#/$defs/bytes" }
      }, "additionalProperties": false
    },
    "question": {
      "type": "object", "required": ["id", "kind", "packetId", "prompt", "choices", "correctChoiceId", "explanation", "focus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "packetId": { "$ref": "#/$defs/id" }, "prompt": { "type": "string", "minLength": 1 }, "explanation": { "type": "string" },
        "kind": { "enum": ["protocol-identification", "field-identification", "field-value", "payload-length", "invalid-field", "multiple-choice"] },
        "choices": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
        "correctChoiceId": { "$ref": "#/$defs/id" },
        "focus": { "type": "object", "required": ["layerIndex", "byteRange"], "properties": { "layerIndex": { "type": "integer", "minimum": 0 }, "fieldId": { "$ref": "#/$defs/id" }, "byteRange": { "type": "object", "required": ["offset", "length"], "properties": { "offset": { "type": "integer", "minimum": 0 }, "length": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false }
      }, "additionalProperties": false
    }
  }
}
